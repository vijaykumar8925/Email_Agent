# =============================================================================
# Mail Agent - Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Application ---
APP_ENV=development                    # development | staging | production
APP_DEBUG=true                         # Enable debug mode (never true in production)
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string
APP_LOG_LEVEL=DEBUG                    # DEBUG | INFO | WARNING | ERROR
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://mailagent:mailagent@localhost:5432/mailagent
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Google Pub/Sub (for Gmail push notifications) ---
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/gmail-push
GOOGLE_PUBSUB_VERIFICATION_TOKEN=your-verification-token

# --- Token Encryption (Fernet keys, comma-separated for rotation) ---
TOKEN_ENCRYPTION_KEYS=generate-with-python-cryptography-fernet-generate-key

# --- Anthropic (AI) ---
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL_CLASSIFIER=claude-sonnet-4-20250514
ANTHROPIC_MODEL_DRAFTER=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS_CLASSIFIER=1024
ANTHROPIC_MAX_TOKENS_DRAFTER=2048
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_CONCURRENT=5

# --- Session ---
SESSION_COOKIE_NAME=mailagent_session
SESSION_MAX_AGE_SECONDS=86400          # 24 hours

# --- Rate Limiting ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_SEND=5/minute

# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Data Retention ---
EMAIL_BODY_RETENTION_DAYS=30           # Set to 0 to keep forever

# --- Frontend (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
